# Absolute path to your Obsidian vault.
VAULT_PATH=C:\path\to\your\obsidian-vault

# Local server bind settings.
HOST=127.0.0.1
PORT=8787

# Optional shared secret. If set, add this header in 社媒助手:
# X-Report-Token: change-me
REPORT_TOKEN=change-me

# Request body limit in bytes. Default: 20 MB.
MAX_BODY_BYTES=20971520
